---
// Origami letters T (index 0) and I (index 1).
//
// Bold geometric sans on the shared grid (cap top y=30, baseline y=130,
// stroke weight 18). Each stem, bar, arm and diagonal is a quad split along
// a crease into two triangular facets; the facet on the lit side of the fold
// takes the lighter tone of its pair. One light source, top-left: bars face
// up and read lightest, stems face sideways and sit mid-to-dark.
//
// Every facet carries its own scatter origin (--og-fx/fy/fr/fs) so the paper
// flies in from a different place and folds into position — see SWIRL-SPEC.md.
// GENERATED by tools/gen-letters.py — edit the letterform definition there and
// re-run `python3 tools/gen-letters.py --write`, don't nudge vertices by hand
// or the silhouette drifts.
---

<!-- T — 6 facets -->
<span class="og-letter" style="--og-i: 0; --og-dir: -1" aria-hidden="true">
  <svg viewBox="0 0 92 140">
    <polygon class="og-facet og-facet--light" style="--og-f: 0; --og-fx: 1.5rem; --og-fy: 0.0rem; --og-fr: -46deg; --og-fs: 0.5" points="0,30 92,48 0,48" />
    <polygon class="og-facet" style="--og-f: 1; --og-fx: -1.62rem; --og-fy: 1.49rem; --og-fr: 7deg; --og-fs: 0.71" points="0,30 92,30 92,48" />
    <polygon class="og-facet" style="--og-f: 2; --og-fx: 0.25rem; --og-fy: -2.89rem; --og-fr: -32deg; --og-fs: 0.64" points="37,48 55,48 37,89" />
    <polygon class="og-facet og-facet--dark" style="--og-f: 3; --og-fx: 1.13rem; --og-fy: 1.47rem; --og-fr: 21deg; --og-fs: 0.57" points="55,48 55,89 37,89" />
    <polygon class="og-facet" style="--og-f: 4; --og-fx: -2.51rem; --og-fy: -0.44rem; --og-fr: -18deg; --og-fs: 0.5" points="37,89 55,130 37,130" />
