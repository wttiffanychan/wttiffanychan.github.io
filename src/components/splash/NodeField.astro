---
// NodeField — canvas molecular node network (the showpiece). See SPLASH-SPEC.md.
---
<canvas class="node-field" data-node-field aria-hidden="true"></canvas>

<style>
  .node-field {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>

<script>
  (() => {
  // Molecular node network — vanilla canvas, tokens only, calm by design.
  // Colors are read from the CSS custom properties at runtime so dark mode
  // swaps automatically; re-read on prefers-color-scheme change.
  const canvas = document.querySelector('[data-node-field]');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  const schemeMQ = matchMedia('(prefers-color-scheme: dark)');
  const reducedMQ = matchMedia('(prefers-reduced-motion: reduce)');
  const staticMode = reducedMQ.matches; // one frame, no loop, no mouse

  // ---- tokens (runtime, never hardcoded) ----
  let accent = null; // [r, g, b]
  let secondary = null;

  function parseColor(value) {
    if (!value) return null;
    const v = value.trim();
    if (v.startsWith('#')) {
      let hex = v.slice(1);
      if (hex.length === 3) hex = hex.split('').map((c) => c + c).join('');
      if (hex.length === 6) {
        const n = parseInt(hex, 16);
        return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
      }
      return null;
    }
    const m = v.match(/rgba?\(([^)]+)\)/);
    if (m) {
      const parts = m[1].split(',').map((s) => parseFloat(s.trim()));
      if (parts.length >= 3 && parts.slice(0, 3).every((x) => !Number.isNaN(x))) {
        return [parts[0], parts[1], parts[2]];
      }
    }
    return null;
  }

  function readTokens() {
    const cs = getComputedStyle(document.documentElement);
    accent = parseColor(cs.getPropertyValue('--accent-decorative'));
    secondary = parseColor(cs.getPropertyValue('--accent-secondary'));
  }
  readTokens();

  // ---- sizing (DPR-aware, capped at 2) ----
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  let w = 0;
  let h = 0;

  function resize() {
    const rect = canvas.getBoundingClientRect();
    w = Math.max(1, Math.round(rect.width));
    h = Math.max(1, Math.round(rect.height));
    canvas.width = Math.round(w * dpr);
    canvas.height = Math.round(h * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  // ---- nodes: 80–120, r 1–2.5px, 2–6 px/s gentle wander ----
  const NODE_MIN = 80;
  const NODE_MAX = 120;
  const LINK_DIST = 110; // proximity line threshold (px)
  const MOUSE_RADIUS = 160; // whisper radius (px)
  const EDGE_MARGIN = 48; // soft steering zone at edges (px)
  const LINE_ALPHA_MAX = 0.16; // within spec's 0.08–0.2 band

  let nodes = [];

  function makeNodes() {
    const target = Math.round((w * h) / 18000);
    const count = Math.min(NODE_MAX, Math.max(NODE_MIN, target));
    nodes = [];
    for (let i = 0; i < count; i++) {
      nodes.push({
        x: Math.random() * w,
        y: Math.random() * h,
        angle: Math.random() * Math.PI * 2,
        speed: 2 + Math.random() * 4, // 2–6 px/s
        wander: (Math.random() - 0.5) * 0.9, // per-node turn bias (rad/s)
        radius: 1 + Math.random() * 1.5, // 1–2.5px
        alpha: 0.25 + Math.random() * 0.25, // 0.25–0.5
        secondary: Math.random() < 0.15, // ~15% sage nodes
      });
    }
  }

  // ---- mouse whisper (window-level; canvas is pointer-events: none) ----
  let mx = null;
  let my = null;
  if (!staticMode) {
    window.addEventListener(
      'mousemove',
      (e) => {
        mx = e.clientX;
        my = e.clientY;
      },
      { passive: true }
    );
    document.addEventListener('mouseleave', () => {
      mx = null;
      my = null;
    });
    window.addEventListener('blur', () => {
      mx = null;
      my = null;
    });
  }

  // ---- update: dt-based drift + edge steering + gentle mouse pull ----
  function update(dt) {
    for (const n of nodes) {
      // slow wandering direction
      n.angle += ((Math.random() - 0.5) * 1.4 + n.wander) * dt;
      let vx = Math.cos(n.angle) * n.speed;
      let vy = Math.sin(n.angle) * n.speed;

      // soft push back inside the viewport (no teleporting wrap)
      if (n.x < EDGE_MARGIN) vx += (EDGE_MARGIN - n.x) * 0.35;
      else if (n.x > w - EDGE_MARGIN) vx -= (n.x - (w - EDGE_MARGIN)) * 0.35;
      if (n.y < EDGE_MARGIN) vy += (EDGE_MARGIN - n.y) * 0.35;
      else if (n.y > h - EDGE_MARGIN) vy -= (n.y - (h - EDGE_MARGIN)) * 0.35;

      // whisper: a soft spring toward the cursor, fading with distance
      if (mx != null) {
        const dx = mx - n.x;
        const dy = my - n.y;
        const d2 = dx * dx + dy * dy;
        if (d2 < MOUSE_RADIUS * MOUSE_RADIUS) {
          const d = Math.sqrt(d2) || 1;
          const pull = 1 - d / MOUSE_RADIUS; // 1 at cursor → 0 at rim
          vx += (dx / d) * pull * 26 * dt;
          vy += (dy / d) * pull * 26 * dt;
        }
      }

      n.x += vx * dt;
      n.y += vy * dt;
    }
  }

  // ---- draw: proximity lines under small nodes ----
  function draw() {
    ctx.clearRect(0, 0, w, h);
    if (!accent && !secondary) return;
    const [ar, ag, ab] = accent || secondary;
    const [sr, sg, sb] = secondary || accent;

    // lines first, alpha fading linearly with distance
    ctx.lineWidth = 0.6;
    for (let i = 0; i < nodes.length; i++) {
      const a = nodes[i];
      for (let j = i + 1; j < nodes.length; j++) {
        const b = nodes[j];
        const dx = a.x - b.x;
        const dy = a.y - b.y;
        const d2 = dx * dx + dy * dy;
        if (d2 > LINK_DIST * LINK_DIST) continue;
        const t = 1 - Math.sqrt(d2) / LINK_DIST;
        ctx.strokeStyle = `rgba(${ar},${ag},${ab},${LINE_ALPHA_MAX * t})`;
        ctx.beginPath();
        ctx.moveTo(a.x, a.y);
        ctx.lineTo(b.x, b.y);
        ctx.stroke();
      }
    }

    // nodes on top
    for (const n of nodes) {
      const c = n.secondary ? secondary : accent;
      if (!c) continue;
      ctx.fillStyle = `rgba(${c[0]},${c[1]},${c[2]},${n.alpha})`;
      ctx.beginPath();
      ctx.arc(n.x, n.y, n.radius, 0, Math.PI * 2);
      ctx.fill();
    }
  }

  // ---- loop + pause on hidden / out of view ----
  let rafId = 0;
  let running = false;
  let last = 0;

  function frame(ts) {
    const dt = Math.min((ts - last) / 1000 || 0.016, 0.05); // clamp jumps
    last = ts;
    update(dt);
    draw();
    rafId = requestAnimationFrame(frame);
  }

  function start() {
    if (running || staticMode || document.hidden) return;
    running = true;
    last = performance.now();
    rafId = requestAnimationFrame(frame);
  }

  function stop() {
    running = false;
    cancelAnimationFrame(rafId);
  }

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) stop();
    else start();
  });

  let io = null;
  if (!staticMode && 'IntersectionObserver' in window) {
    io = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) start();
        else stop();
      }
    });
    io.observe(canvas);
  }

  // ---- resize: debounced ~150ms, rescale node positions ----
  let resizeTimer = 0;
  window.addEventListener(
    'resize',
    () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        const ow = w;
        const oh = h;
        resize();
        if (nodes.length) {
          for (const n of nodes) {
            n.x = (n.x / ow) * w;
            n.y = (n.y / oh) * h;
          }
        }
        if (staticMode) draw();
        else if (!document.hidden) start();
      }, 150);
    },
    { passive: true }
  );

  // dark mode: tokens swap at runtime — re-read and keep drawing
  schemeMQ.addEventListener('change', readTokens);

  // ---- go ----
  resize();
  makeNodes();
  if (staticMode) {
    draw(); // one static frame, no loop, no mouse influence
  } else {
    start();
  }
  })();
</script>
