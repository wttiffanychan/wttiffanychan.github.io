---
import BaseLayout from '../layouts/BaseLayout.astro';
import OrigamiCrane from '../components/origami/origami-crane.astro';
---
<BaseLayout
  title="Bio — Tiffany"
  description="Who I am: a product marketing manager, comfortable where marketing meets operations."
>
  <section class="section">
    <div class="container">
      <header class="page-head fade-up">
        <p class="eyebrow">Bio</p>
        <h1>About</h1>
        <!-- the crane from the splash, folded once more at reading size -->
        <span class="head-motif">
          <OrigamiCrane size="clamp(3rem, 8vw, 4.5rem)" delay="0.35s" />
        </span>
      </header>

      <p class="lede intro fade-up">
        I make technical products clear to the people who have to trust them.
      </p>

      <ul class="tiles fade-up">
        <li class="tile">
          <svg class="tile-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 4h8" />
            <path d="M14 4v9.3c0 1-.4 1.9-1.1 2.6L9.4 19.6c-1.6 1.7-.4 4.4 2 4.4h9.2c2.4 0 3.6-2.7 2-4.4l-3.5-3.7c-.7-.7-1.1-1.6-1.1-2.6V4" />
            <path d="M10.3 18.5h11.4" />
          </svg>
          <p class="tile-label">Clinical diagnostics &amp; lab medicine</p>
          <p class="tile-detail">Transplant, infectious disease, immunology — for the labs and hospitals that run the tests.</p>
        </li>
        <li class="tile">
          <svg class="tile-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 4 27 10 27 22 16 28 5 22 5 10Z" />
            <path d="M5 10 16 16 27 10" />
            <path d="M16 16v12" />
          </svg>
          <p class="tile-label">Medical devices &amp; healthcare products</p>
          <p class="tile-detail">Product management and sourcing — requirements through launch, and everything between.</p>
        </li>
        <li class="tile">
          <svg class="tile-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="16" cy="16" r="5" />
            <path d="M16 3v4M16 25v4M3 16h4M25 16h4M7.5 7.5l2.8 2.8M21.7 21.7l2.8 2.8M7.5 24.5l2.8-2.8M21.7 10.3l2.8-2.8" />
          </svg>
          <p class="tile-label">Industrial manufacturing &amp; engineered materials</p>
          <p class="tile-detail">Engineered polymers — wind energy, oil and gas, industrial.</p>
        </li>
      </ul>

      <p class="throughline fade-up">
        Different buyers, same instinct: make the technical case plainly, and trust the reader.
      </p>

      <p class="edu fade-up">
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M16 5.5 30 12 16 18.5 2 12z" />
          <circle cx="16" cy="12" r="1.4" />
          <path d="M16 18.5V24" />
          <path d="M16 24l2.4 1.1" />
        </svg>
        <span>Babson College</span>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* the page's one origami accent: sits at the outer edge of the header,
     aligned with the title, never in the reading column */
  .page-head { position: relative; }
  .head-motif {
    position: absolute;
    right: 0;
    bottom: 0;
    /* meant to be seen: the figure is part of the page, not a watermark.
       The paper tones are soft enough at full strength that it still sits
       behind the title in the reading order. */
    opacity: 0.95;
  }
  /* it shrinks with the header (the size is a clamp) and only steps out on a
     phone-width header, where the title needs the whole line */
  @media (max-width: 26rem) {
    .head-motif { display: none; }
  }
  .intro {
    margin-bottom: 2.75rem;
  }
  .tiles {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    max-width: 62rem;
  }
  .tile {
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: 1rem;
    padding: clamp(1.5rem, 3vw, 2.1rem);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .tile:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--accent-decorative) 45%, var(--border));
    box-shadow: 0 14px 30px -18px color-mix(in srgb, var(--text) 45%, transparent);
  }
  .tile-icon {
    display: block;
    width: 28px;
    height: 28px;
    color: var(--accent-decorative);
    margin-bottom: 1.5rem;
    transition: color 0.25s ease;
  }
  .tile:hover .tile-icon { color: var(--accent-interactive); }
  .tile-label {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 400;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--text);
    margin-bottom: 0.6rem;
  }
  .tile-detail {
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.5;
  }
  .throughline {
    max-width: 34rem;
    margin-top: 2.5rem;
    font-family: 'Fraunces', Georgia, serif;
    font-style: italic;
    font-weight: 300;
    font-size: 1.05rem;
    color: var(--text-muted);
  }
  .edu {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-top: 2.75rem;
    color: var(--text-muted);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }
  .edu svg {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .tile { transition: none; }
    .tile:hover { transform: none; }
  }
  @media (max-width: 56rem) {
    .tiles { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 34rem) {
    .tiles { grid-template-columns: 1fr; }
  }
</style>
