---
import BaseLayout from '../layouts/BaseLayout.astro';
import OrigamiButterfly from '../components/origami/origami-butterfly.astro';
---
<BaseLayout
  title="Interest — Tiffany"
  description="What I do and think about off the clock."
>
  <section class="section">
    <div class="container">
      <header class="page-head fade-up">
        <p class="eyebrow">Interest</p>
        <h1>Off the clock</h1>
        <!-- the butterfly from the splash: the lightest fold on the page -->
        <span class="head-motif">
          <OrigamiButterfly size="clamp(2.9rem, 7.5vw, 4.2rem)" delay="0.35s" />
        </span>
      </header>
      <ul class="list">
        <li class="entry fade-up">
          <svg class="motif" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
            <circle cx="9" cy="9" r="1.5" />
            <circle cx="15" cy="5" r="1" />
            <circle cx="21" cy="10" r="2" />
            <circle cx="27" cy="6" r="1" />
            <circle cx="11" cy="19" r="1" />
            <circle cx="19" cy="17" r="1.5" />
            <circle cx="26" cy="21" r="1" />
            <circle cx="7" cy="26" r="1" />
          </svg>
          <div class="body">
            <h2>The brain</h2>
            <p>Choreography, instruments, memory — practice that keeps the brain sharp.</p>
          </div>
        </li>
        <li class="entry fade-up">
          <svg class="motif" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <path d="M6 10h12M6 16h16M6 22h9" />
          </svg>
          <div class="body">
            <h2>Languages</h2>
            <p>Spanish and Mandarin, a little daily. Listening first.</p>
          </div>
        </li>
        <li class="entry fade-up">
          <svg class="motif" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <path d="M3 20c6-8 10-8 13-3s6 5 13-3" />
            <circle cx="26" cy="13" r="1.6" fill="currentColor" stroke="none" />
          </svg>
          <div class="body">
            <h2>Movement</h2>
            <p>Pilates, weights, cardio. The same set, for years.</p>
          </div>
        </li>
        <li class="entry fade-up">
          <svg class="motif" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 24c5-10 10 4 15-6s6-2 9 1" stroke-dasharray="0.5 3.5" />
            <circle cx="4" cy="24" r="2" fill="currentColor" stroke="none" />
            <circle cx="28" cy="19" r="2" fill="currentColor" stroke="none" />
          </svg>
          <div class="body">
            <h2>Food &amp; travel</h2>
            <p>Trips planned around a meal — and whoever's cooking it.</p>
          </div>
        </li>
        <li class="entry fade-up">
          <svg class="motif" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 10v14" />
            <path d="M16 10c-3-2-6-2.6-9-2.6v13.4c3 0 6 .6 9 2.6" />
            <path d="M16 10c3-2 6-2.6 9-2.6v13.4c-3 0-6 .6-9 2.6" />
          </svg>
          <div class="body">
            <h2>Reading</h2>
            <p>Long books, one at a time. The footnotes too.</p>
          </div>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* the page's one origami accent: sits at the outer edge of the header,
     aligned with the title, never in the reading column */
  .page-head { position: relative; }
  .head-motif {
    position: absolute;
    right: 0;
    bottom: 0;
    /* meant to be seen: the figure is part of the page, not a watermark.
       The paper tones are soft enough at full strength that it still sits
       behind the title in the reading order. */
    opacity: 0.95;
  }
  /* it shrinks with the header (the size is a clamp) and only steps out on a
     phone-width header, where the title needs the whole line */
  @media (max-width: 26rem) {
    .head-motif { display: none; }
  }
  .list {
    max-width: 38rem;
    display: grid;
    gap: 0;
  }

  .entry {
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    gap: 1.25rem;
    align-items: start;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .entry:last-child {
    border-bottom: none;
  }

  .motif {
    width: 2.75rem;
    height: 2.75rem;
    margin-top: 0.25rem;
    color: var(--accent-decorative);
    opacity: 0.55;
  }

  .body h2 {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 1.1rem;
    font-weight: 500;
    margin-bottom: 0.3rem;
  }

  .body p {
    color: var(--text-muted);
    font-size: 0.95rem;
    max-width: 30rem;
  }

  /* five entries, so the stagger runs to nth-child(5); same 0.08s step */
  .entry:nth-child(2) { animation-delay: 0.08s; }
  .entry:nth-child(3) { animation-delay: 0.16s; }
  .entry:nth-child(4) { animation-delay: 0.24s; }
  .entry:nth-child(5) { animation-delay: 0.32s; }

  @media (max-width: 30rem) {
    .entry {
      grid-template-columns: 2rem 1fr;
      gap: 0.9rem;
    }
    .motif {
      width: 2rem;
      height: 2rem;
    }
  }
</style>
