---
// Splash variant D — "Editorial" (Prada / Miu Miu direction). See VARIANT-SPEC.md.
// Garment-label precision: small-caps Archivo name with rules above/below,
// a low-opacity frame with one terracotta corner tack, fine diagonal nylon
// hatch, a rotated "est. curious" tag. Tokens only; reduced-motion = static.
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Tiffany — Splash D (Editorial)"
  description="Splash variant: architectural minimalism."
>
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500&display=swap"
  />
  <section class="variant-d">
    <!-- fine diagonal nylon-hatch backdrop -->
    <div class="vd-hatch" aria-hidden="true"></div>

    <!-- rectangular frame outline + one bold solid terracotta tack -->
    <div class="vd-stage" aria-hidden="true">
      <div class="vd-frame"></div>
      <div class="vd-accent"></div>
    </div>

    <!-- the garment label, upper-left, asymmetric -->
    <div class="vd-label">
      <span class="vd-rule vd-rule--top"></span>
      <h1 class="vd-name">tiffany</h1>
      <span class="vd-rule vd-rule--bottom"></span>
      <p class="vd-role">— product marketing manager —</p>
    </div>

    <!-- unexpected garment-tag detail -->
    <p class="vd-tag" aria-hidden="true">est. curious</p>
  </section>
</BaseLayout>

<style>
  .variant-d {
    min-height: 100svh;
    display: grid;
    place-items: center;
    position: relative;
    overflow: hidden;
    padding: 2rem;
    background: var(--bg);
  }

  /* fine diagonal nylon-hatch texture — token color, very low opacity */
  .vd-hatch {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.05;
    background-image: repeating-linear-gradient(
      45deg,
      var(--text) 0 1px,
      transparent 1px 5px
    );
  }

  /* frame + accent share one positioned stage (frame opacity must not
     wash the accent, so the stage itself carries no opacity) */
  .vd-stage {
    position: absolute;
    top: clamp(3.5rem, 12vh, 6rem);
    left: clamp(1.5rem, 7vw, 4.5rem);
    width: clamp(14rem, 34vw, 24rem);
    height: clamp(15rem, 48vh, 26rem);
    z-index: 1;
  }

  .vd-frame {
    position: absolute;
    inset: 0;
    border: 1px solid var(--text);
    opacity: 0.12;
    animation: vd-frame-in 0.35s ease-out 0.08s both;
  }

  /* one bold solid accent — terracotta tack on the frame's corner */
  .vd-accent {
    position: absolute;
    top: -0.35rem;
    right: -0.35rem;
    width: 0.7rem;
    height: 0.7rem;
    background: var(--accent-decorative);
    animation: vd-accent-in 0.28s cubic-bezier(0.22, 1, 0.36, 1) 0.48s both;
  }

  /* garment label: rules above/below the name, role line beneath */
  .vd-label {
    position: absolute;
    top: clamp(7.5rem, 26vh, 12rem);
    left: clamp(2.25rem, 10vw, 6.5rem);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .vd-rule {
    width: 3.5rem;
    height: 1px;
    background: var(--text);
    opacity: 0.7;
    transform-origin: left;
    animation: vd-rule-in 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .vd-rule--top { animation-delay: 0.04s; }
  .vd-rule--bottom { animation-delay: 0.16s; }

  .vd-name {
    font-family: 'Archivo', sans-serif;
    font-weight: 400;
    font-variant-caps: small-caps;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: 0.2em;
    margin: 0.85rem 0;
    animation: vd-name-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.18s both;
  }

  .vd-role {
    margin-top: 1.4rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    color: var(--text-muted);
    animation: vd-fade 0.3s ease-out 0.55s both;
  }

  /* rotated garment tag along the right edge */
  .vd-tag {
    position: absolute;
    right: clamp(1.75rem, 5vw, 3.5rem);
    bottom: clamp(5rem, 16vh, 8rem);
    transform-origin: right bottom;
    transform: rotate(90deg);
    z-index: 2;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.22em;
    color: var(--text-muted);
    animation: vd-fade 0.35s ease-out 0.65s both;
  }

  /* ——— motion: ~1s runway precision, then stillness ——— */
  @keyframes vd-rule-in {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }
  @keyframes vd-name-in {
    from { opacity: 0; letter-spacing: 0.12em; }
    to   { opacity: 1; letter-spacing: 0.2em; }
  }
  @keyframes vd-frame-in {
    from { opacity: 0; }
    to   { opacity: 0.12; }
  }
  @keyframes vd-accent-in {
    from { opacity: 0; transform: translate(0.4rem, 0.4rem); }
    to   { opacity: 1; transform: translate(0, 0); }
  }
  @keyframes vd-fade {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* reduced motion: fully composed static frame, no animation */
  @media (prefers-reduced-motion: reduce) {
    .vd-rule,
    .vd-name,
    .vd-role,
    .vd-frame,
    .vd-accent,
    .vd-tag {
      animation: none;
    }
  }
</style>
