---
// Splash variant B — "Atomic" (midcentury modern). See VARIANT-SPEC.md.
import BaseLayout from '../layouts/BaseLayout.astro';

// Sunburst rays — generated at build time, vanilla SVG.
const RAYS = 36;
const rays = Array.from({ length: RAYS }, (_, i) => {
  const a = (i / RAYS) * Math.PI * 2;
  return {
    x1: 50 + Math.cos(a) * 10,
    y1: 50 + Math.sin(a) * 10,
    x2: 50 + Math.cos(a) * 48,
    y2: 50 + Math.sin(a) * 48,
    alt: i % 2 === 1,
  };
});
---
<BaseLayout
  title="Tiffany — Splash B (Atomic)"
  description="Splash variant: geometric optimism."
>
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600&display=swap"
  />
  <section class="variant-b">
    <!-- atmosphere layers (all decorative) -->
    <svg class="sunburst" viewBox="0 0 100 100" aria-hidden="true">
      {rays.map((r) => (
        <line
          class:list={['ray', { 'ray--alt': r.alt }]}
          x1={r.x1}
          y1={r.y1}
          x2={r.x2}
          y2={r.y2}
          stroke="currentColor"
          stroke-width="0.35"
          stroke-linecap="round"
        />
      ))}
    </svg>
    <svg class="arcs" viewBox="0 0 100 100" aria-hidden="true">
      <circle class="arc arc--terracotta" cx="50" cy="50" r="42" fill="none" stroke-width="0.55" stroke-dasharray="26 999" stroke-linecap="round" />
      <circle class="arc arc--sage" cx="50" cy="50" r="30" fill="none" stroke-width="0.55" stroke-dasharray="20 999" stroke-linecap="round" />
      <circle class="arc arc--terracotta" cx="50" cy="50" r="18" fill="none" stroke-width="0.55" stroke-dasharray="14 999" stroke-linecap="round" />
    </svg>
    <svg class="horizon" viewBox="0 0 200 40" aria-hidden="true">
      <line class="horizon-line" x1="0" y1="36" x2="200" y2="36" />
      <circle class="sun" cx="138" cy="27" r="9" />
      <circle class="sun-ring" cx="138" cy="27" r="14" fill="none" stroke-width="0.7" />
    </svg>
    <div class="shape shape--circle" aria-hidden="true"></div>
    <div class="shape shape--arch" aria-hidden="true"></div>
    <div class="shape shape--dot" aria-hidden="true"></div>
    <div class="shape shape--dot-sage" aria-hidden="true"></div>

    <!-- hero -->
    <div class="hero">
      <h1 class="name" aria-label="Tiffany">
        <span class="char char--accent" aria-hidden="true">T</span><span class="char char--accent" aria-hidden="true">I</span><span class="char char--accent" aria-hidden="true">F</span><span class="char" aria-hidden="true">F</span><span class="char" aria-hidden="true">A</span><span class="char" aria-hidden="true">N</span><span class="char" aria-hidden="true">Y</span>
      </h1>
      <p class="role">Product Marketing Manager</p>
    </div>
  </section>
</BaseLayout>

<style>
  .variant-b {
    min-height: 100svh;
    display: grid;
    place-items: center;
    position: relative;
    overflow: hidden;
    padding: 2rem;
    background: var(--bg);
  }

  /* === sunburst === */
  .sunburst {
    position: absolute;
    left: 50%;
    top: 50%;
    width: clamp(300px, 46vmin, 520px);
    height: clamp(300px, 46vmin, 520px);
    color: var(--accent-decorative);
    opacity: 0.45;
    pointer-events: none;
    will-change: transform;
    transform-origin: center;
    animation: sunburst-spin 75s linear infinite;
  }
  .sunburst .ray--alt { color: var(--accent-secondary); }
  @keyframes sunburst-spin {
    from { transform: translate(-50%, -50%) rotate(0deg); }
    to   { transform: translate(-50%, -50%) rotate(360deg); }
  }

  /* === concentric arcs === */
  .arcs {
    position: absolute;
    top: 9%;
    right: 5%;
    width: clamp(150px, 19vmin, 230px);
    height: clamp(150px, 19vmin, 230px);
    opacity: 0.35;
    pointer-events: none;
    transform: rotate(18deg);
  }
  .arcs .arc--terracotta { stroke: var(--accent-decorative); }
  .arcs .arc--sage { stroke: var(--accent-secondary); }

  /* === horizon + sun === */
  .horizon {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: auto;
    pointer-events: none;
  }
  .horizon .horizon-line { stroke: var(--text); stroke-width: 0.8; opacity: 0.28; }
  .horizon .sun { fill: var(--accent-decorative); opacity: 0.5; }
  .horizon .sun-ring { stroke: var(--accent-secondary); opacity: 0.55; }

  /* === floating shapes === */
  .shape {
    position: absolute;
    pointer-events: none;
    opacity: var(--shape-opacity, 0.5);
    animation: shape-pop 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }
  .shape--circle {
    top: 16%;
    left: 9%;
    width: 44px;
    height: 44px;
    border: 1px solid var(--accent-secondary);
    border-radius: 50%;
    --shape-opacity: 0.45;
    animation-delay: 0.3s;
  }
  .shape--arch {
    top: 58%;
    left: 5%;
    width: 46px;
    height: 23px;
    border: 1px solid var(--accent-decorative);
    border-bottom: none;
    border-radius: 46px 46px 0 0;
    --shape-opacity: 0.4;
    animation-delay: 0.45s;
  }
  .shape--dot {
    top: 27%;
    right: 11%;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent-decorative);
    --shape-opacity: 0.55;
    animation-delay: 0.6s;
  }
  .shape--dot-sage {
    bottom: 22%;
    left: 14%;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-secondary);
    --shape-opacity: 0.5;
    animation-delay: 0.75s;
  }
  @keyframes shape-pop {
    from { opacity: 0; transform: scale(0.4); }
    to   { opacity: var(--shape-opacity, 0.5); transform: scale(1); }
  }

  /* === hero: name + role === */
  .hero {
    position: relative;
    z-index: 1;
    text-align: center;
  }
  .name {
    margin: 0;
    font-family: 'Jost', 'Futura', sans-serif;
    font-weight: 600;
    font-size: clamp(3rem, 8vw, 5.5rem);
    letter-spacing: 0.08em;
    line-height: 1.1;
    color: var(--text);
    /* cancel trailing letter-spacing so the block centers exactly */
    margin-right: -0.08em;
  }
  .name .char {
    display: inline-block;
    animation: char-rise 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }
  .name .char--accent { color: var(--accent-decorative); }
  .name .char:nth-child(1) { animation-delay: 0.08s; }
  .name .char:nth-child(2) { animation-delay: 0.13s; }
  .name .char:nth-child(3) { animation-delay: 0.18s; }
  .name .char:nth-child(4) { animation-delay: 0.23s; }
  .name .char:nth-child(5) { animation-delay: 0.28s; }
  .name .char:nth-child(6) { animation-delay: 0.33s; }
  .name .char:nth-child(7) { animation-delay: 0.38s; }
  @keyframes char-rise {
    from { opacity: 0; transform: translateY(0.55em); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .role {
    margin: 1.5rem 0 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-muted);
    animation: role-in 0.7s ease 0.5s both;
  }
  @keyframes role-in {
    from { opacity: 0; transform: translateY(5px); }
    to   { opacity: 1; transform: none; }
  }

  /* === reduced motion: static, fully composed === */
  @media (prefers-reduced-motion: reduce) {
    .sunburst, .char, .role, .shape { animation: none; }
  }
</style>
